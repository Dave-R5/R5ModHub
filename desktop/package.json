{
  "name": "modweergave",
  "productName": "R5 ModHub",
  "version": "1.6.5",
  "description": "R5 ModHub, modtool voor Twitch, als Windows-app (laadt r5mod.daver5.nl)",
  "main": "main.js",
  "author": "Dave",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "nl.daver5.modweergave",
    "productName": "R5 ModHub",
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "R5-ModHub-Setup-${version}.exe",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "R5 ModHub"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/Dave-R5/modweergave/releases/latest/download"
      }
    ]
  },
  "repository": "github:Dave-R5/modweergave",
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
